NPM_REGISTRY=https://registry.npmmirror.com

POSTGRES_USER=price
POSTGRES_PASSWORD=price
POSTGRES_DB=price_loader

# --- Stage-2 скрипты (scripts/db_config.py): подключение к price-db через опубликованный порт ---
# Порт 55433 проброшен в docker-compose.yml для сервиса price-db.
# Раскомментируйте строки, чтобы переопределить дефолты scripts/db_config.py:
# PRICE_DB_HOST=127.0.0.1
# PRICE_DB_PORT=55433
# PRICE_DB_USER=price
# PRICE_DB_PASSWORD=price
# PRICE_DB_NAME=price_loader
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_ENDPOINT=localhost:9000

APP_ADMIN_USERNAME=admin@docprice.internal
APP_ADMIN_PASSWORD=admin
APP_USER_USERNAME=manager@docprice.internal.local
APP_USER_PASSWORD=manager
APP_SYSADMIN_USERNAME=sysadmin@docprice.internal
APP_SYSADMIN_PASSWORD=sysadmin
APP_VIEWER_USERNAME=viewer@docprice.internal
APP_VIEWER_PASSWORD=viewver
APP_AUTH_SECRET=generate-a-local-secret
APP_ACCESS_TOKEN_EXPIRY_MINUTES=15
APP_REFRESH_TOKEN_EXPIRY_DAYS=7
APP_AUTH_SECURE_COOKIES=false
PHASE3_AUTH_SECRET=

PRICE_IMPORT_SERVICE_ENABLED=false
SERVICE_API_KEY_PEPPER=
PRICE_IMPORT_STALE_AFTER_SECONDS=3600
PRICE_IMPORT_WEBHOOK_TIMEOUT_SECONDS=15

# Интеграция с Bitrix24 (docs/api/integrations/bitrix/README.md).
# disabled — выключена (маршруты отвечают 503), fake — встроенный стенд без
# сети, webhook — реальный портал. Имена полей сделки не угадываются: их даёт
# заказчик, до этого режим webhook включать нельзя.
BITRIX_MODE=fake
BITRIX_BASE_URL=
BITRIX_WEBHOOK_TOKEN=
BITRIX_TENDER_FIELD=UF_CRM_TENDER_ID
# JSON-массив UF-полей сделки с файлами, например ["UF_CRM_1700000000"].
BITRIX_FILE_FIELDS=[]
# Вложения комментариев ленты — так их кладёт почтовый контур Фазы 1.
BITRIX_READ_TIMELINE_FILES=true
BITRIX_DEAL_FOLDER_FIELD=
BITRIX_REPORT_FOLDER_ID=
BITRIX_TIMEOUT_SECONDS=20
# Отдельный бюджет на скачивание файла сделки.
BITRIX_DOWNLOAD_TIMEOUT_SECONDS=180
BITRIX_MAX_ATTEMPTS=5
BITRIX_RETRY_BASE_SECONDS=5
BITRIX_RETRY_MAX_SECONDS=900

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_RULE_MODEL=gpt-4o
OPENAI_RULE_MODELS=gpt-4o
OPENAI_RULE_BATCH_PAGE_SIZE=24
OPENAI_RULE_MAX_SECTIONS_PER_OPERATION=512
OPENAI_RULE_START_COOLDOWN_SECONDS=300
OPENAI_RULE_TIMEOUT_SECONDS=75
OPENAI_RULE_MAX_OUTPUT_TOKENS=3500

# Генерация правил секциями с хранением состояния в PostgreSQL: секции идут
# независимыми задачами, успешные материализуются сразу, зависшие подбираются
# повторно. Требует запущенного price-beat — иначе очередь секций никто не
# разбирает. DURABLE_RULE_GENERATION_ENABLED=false возвращает прежний
# батч-режим одной задачей.
DURABLE_RULE_GENERATION_ENABLED=true
# Детерминированный разбор до обращения к модели: секции с распознанной
# структурой не уходят в LLM вовсе.
RULE_GENERATION_FAST_PATH_ENABLED=true
# Аренда на секцию покрывает попытки к провайдеру и одну семантическую
# починку; продлевается heartbeat-ом, пока задача жива.
RULE_GENERATION_LEASE_SECONDS=900
RULE_GENERATION_DISPATCH_LIMIT=100
RULE_GENERATION_DISPATCH_INTERVAL_SECONDS=30
RULE_GENERATION_RECOVERY_INTERVAL_SECONDS=60
# Dev-only: RULE_GENERATION_STUB_MODE=true returns a deterministic stub proposal
# without calling an external LLM, so imports without a configured key still
# finish normally. Keep false in production with a real key configured.
RULE_GENERATION_STUB_MODE=false

LLM_PROVIDER=yandexgpt
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_API_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEXGPT_RULE_MODEL=qwen3-235b-a22b-fp8/latest
YANDEXGPT_RULE_MODELS=qwen3-235b-a22b-fp8/latest,qwen3.6-35b-a3b/latest,deepseek-v4-flash/latest,yandexgpt-5.1/latest

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_RULE_MODEL=deepseek-v4-flash
DEEPSEEK_RULE_MODELS=deepseek-v4-flash,deepseek-v4-pro

FSA_BASE_URL=http://fsa-api:8100
