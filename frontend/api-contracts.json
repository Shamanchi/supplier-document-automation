                "title": { "type": "string" },
                "createdAt": { "type": "string" },
                "type": { "type": "string", "enum": ["discount", "vat"] },
                "status": {
                  "type": "string",
                  "enum": ["pending", "approved", "rejected"]
                }
              }
            }
          },
          "permissions": {
            "type": "object",
            "required": ["admin", "manager", "sysadmin"],
            "properties": {
              "admin": { "type": "array", "items": { "type": "string" } },
              "manager": { "type": "array", "items": { "type": "string" } },
              "sysadmin": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
