          "equipment": { "type": "string" },
          "tool": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["success", "warning", "danger"]
          },
          "statusLabel": { "type": "string" },
          "parameters": { "type": "string" }
        }
      },
      "Supplier": {
        "type": "object",
        "required": [
          "id",
          "name",
          "products",
          "files",
          "pricing",
          "discountRules",
          "certificates"
        ],
        "properties": {
          "id": { "type": "string" },
