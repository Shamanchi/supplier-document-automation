                  "type": "string",
                  "enum": ["pending", "accepted", "rejected"]
                }
              }
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "equipment": { "type": "string" },
                "parameters": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "ProfileData": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "initials": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "notifications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
