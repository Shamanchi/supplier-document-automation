            "type": "string",
            "enum": ["confirmed", "draft", "cancelled"]
          },
          "final": { "type": "boolean" }
        }
      },
      "OrderDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/OrderSummary" },
          {
            "type": "object",
            "required": [
              "createdBy",
              "importedAt",
              "calculationVersion",
              "lifecycle",
              "currentLifecycle",
              "sent",
              "readOnly",
              "files",
              "techParameters",
              "pricePositions",
              "quotePositions",
              "vatRate",
              "automaticDiscount",
              "specialDiscount",
              "discountApproval",
              "supplierTotals",
              "versions",
              "auditLog"
            ],
            "properties": {
              "createdBy": { "type": "string" },
              "importedAt": { "type": "string" },
              "calculationVersion": { "type": "string" },
              "lifecycle": {
                "type": "array",
                "items": { "type": "string" }
              },
              "currentLifecycle": { "type": "integer" },
              "sent": { "type": "boolean" },
              "readOnly": { "type": "boolean" },
              "files": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/OrderFile" }
              },
              "techParameters": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/TechParameter" }
              },
              "pricePositions": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PricePosition" }
              },
              "quotePositions": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/QuotePosition" }
              },
              "vatRate": { "type": "number" },
              "automaticDiscount": { "type": "number" },
              "specialDiscount": { "type": "number" },
              "discountApproval": {
                "type": "string",
                "enum": ["pending", "approved", "rejected"]
              },
              "supplierTotals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "supplier": { "type": "string" },
                    "amount": { "type": "number" },
                    "weight": { "type": "string" },
                    "volume": { "type": "string" }
                  }
                }
              },
              "versions": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/OrderVersion" }
              },
              "auditLog": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "time": { "type": "string" },
                    "user": { "type": "string" },
                    "action": { "type": "string" },
                    "value": { "type": "string" },
                    "reason": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      },
      "UpdateQuoteRequest": {
        "type": "object",
        "properties": {
          "vatRate": { "type": "number", "minimum": 0, "maximum": 100 },
          "specialDiscount": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "supplierId": { "type": "string" },
          "reason": { "type": "string" }
        },
        "description": "Для ручного изменения vatRate или specialDiscount поле reason обязательно."
      },
      "UploadFileRequest": {
        "type": "object",
        "required": ["fileName", "kind"],
        "properties": {
