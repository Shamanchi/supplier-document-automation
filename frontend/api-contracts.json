                  "type": "array",
                  "items": { "type": "string" }
                },
                "supplierNames": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "approvedSynonyms": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
