                "coefficient": { "type": "number" },
                "baseUnit": { "type": "string" },
                "example": { "type": "string" }
              }
            }
          },
          "materials": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      },
      "AdminSettings": {
        "type": "object",
        "required": ["vatRate", "confidenceHigh", "confidenceMedium"],
        "properties": {
          "vatRate": { "type": "number" },
          "confidenceHigh": { "type": "number" },
          "confidenceMedium": { "type": "number" }
        }
      },
      "AdminData": {
        "type": "object",
        "properties": {
          "settings": { "$ref": "#/components/schemas/AdminSettings" },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "synonym": { "type": "string" },
                "canonical": { "type": "string" },
                "author": { "type": "string" },
