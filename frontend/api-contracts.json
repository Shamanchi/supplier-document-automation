              "categoryDiscount": { "type": "number" },
              "markup": { "type": "number" },
              "priceUploadedAt": { "type": "string" },
              "certificateUpdatedAt": { "type": "string" }
            }
          },
          "discountRules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "percent": { "type": "number" },
                "condition": { "type": "string" },
                "active": { "type": "boolean" }
              }
            }
          },
          "certificates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "number": { "type": "string" },
                "type": { "type": "string" },
                "status": { "type": "string", "enum": ["active", "expired"] },
                "validUntil": { "type": "string" }
              }
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sku": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "specifications": { "type": "string" },
          "unit": { "type": "string" },
          "supplier": { "type": "string" },
          "documentType": { "type": "string" }
        }
      },
      "Certificate": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "supplier": { "type": "string" },
          "product": { "type": "string" },
          "number": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "expired"] },
          "validUntil": { "type": "string" },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" },
                "document": { "type": "string" },
                "page": { "type": "string" },
                "quote": { "type": "string" }
              }
            }
          }
        }
      },
