DATABASE_URL=postgresql+asyncpg://fsa:fsa@localhost:55434/fsa

MINIO_ENDPOINT=localhost:9110
MINIO_PUBLIC_ENDPOINT=localhost:9110
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=fsa-documents

# Движок OCR. Все шесть сервисов из ../../ocr говорят на одном контракте,
# поэтому смена движка не требует изменений в коде: paddle 8101,
# tesseract 8102, easy 8103, rapidocr 8104, phocr 8105, surya 8106.
OCR_ENGINE=paddle
OCR_ENGINE_HOST=127.0.0.1
OCR_ENGINE_KEY=

# Внутренний токен сервиса: им закрыты все маршруты /v1/*. Пустое значение
# оставляет контур закрытым — случайно открыть его нельзя.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FSA_API_TOKEN=

# Celery: очередь распознавания и импорта реестра
REDIS_URL=redis://localhost:6389/0
CELERY_TASK_ALWAYS_EAGER=false
